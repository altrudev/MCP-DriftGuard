[Unit]
Description=Read-only Frequency Conduit DriftGuard verification

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=mcp-driftguard-monitor
StateDirectoryMode=0700
Environment=TMPDIR=/var/lib/mcp-driftguard-monitor/tmp
ExecStart=/usr/bin/python3 /opt/mcp-driftguard/scripts/production_monitor.py --config /etc/mcp-driftguard/approved-monitor.json --state-dir /var/lib/mcp-driftguard-monitor --alert-config /etc/mcp-driftguard/alerts.json
TimeoutStartSec=90
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=16
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
